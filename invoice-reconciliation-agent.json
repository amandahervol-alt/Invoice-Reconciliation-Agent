{
  "name": "Invoice Reconciliation Agent Workflow",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "folder",
        "folderId": "YOUR_GOOGLE_DRIVE_INVOICES_FOLDER_ID"
      },
      "name": "Google Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://your-cloud-run-pdf-parser.run.app/parse",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"file_url\": \"{{ $json.webContentLink }}\",\n  \"filename\": \"{{ $json.name }}\"\n}"
      },
      "name": "Parse PDF (Cloud Run)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "YOUR_ANTHROPIC_API_KEY"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-5-5\",\n  \"max_tokens\": 4096,\n  \"output_config\": { \"effort\": \"low\" },\n  \"system\": \"You are an invoice parsing assistant. Extract structured JSON from raw invoice text without hallucinating.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Extract structured JSON from the invoice text below.\\nSchema:\\n{\\\"vendor_name\\\": \\\"string\\\", \\\"invoice_number\\\": \\\"string\\\", \\\"po_number\\\": \\\"string\\\", \\\"invoice_date\\\": \\\"YYYY-MM-DD\\\", \\\"line_items\\\": [{\\\"description\\\": \\\"string\\\", \\\"quantity\\\": number, \\\"unit_price\\\": number, \\\"total_price\\\": number}], \\\"subtotal\\\": number, \\\"tax\\\": number, \\\"total_amount\\\": number}\\n\\nInvoice Text:\\n{{ $json.text }}\"\n    }\n  ]\n}"
      },
      "name": "Extract Invoice Fields (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Claude's Messages API response holds the invoice as JSON text inside a \"text\" block.\n// Thinking blocks may come first, so find the first text block instead of assuming the first block.\nconst block = ($json.content || []).find(b => b.type === 'text');\nif (!block || !block.text) {\n  throw new Error('Claude response contained no text block');\n}\n// Accept a bare JSON object or one wrapped in prose / a ```json fence.\nconst match = block.text.match(/\\{[\\s\\S]*\\}/);\nif (!match) {\n  throw new Error('Claude response did not contain a JSON object: ' + block.text.slice(0, 200));\n}\nconst invoice = JSON.parse(match[0]);\ninvoice.po_number = invoice.po_number ? String(invoice.po_number).trim().toUpperCase() : null;\nreturn { json: invoice };\n"
      },
      "name": "Parse Invoice JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "lookup",
        "documentId": "YOUR_GOOGLE_SHEET_PO_DATABASE_ID",
        "sheetName": "PurchaseOrders",
        "lookupColumn": "po_number",
        "lookupValue": "={{ $json.po_number || '' }}"
      },
      "name": "Lookup PO (Google Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "url": "https://your-cloud-run-reconciler.run.app/reconcile",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"invoice\": {{ JSON.stringify($node[\"Parse Invoice JSON\"].json) }},\n  \"purchase_order\": {{ JSON.stringify($json) }},\n  \"dollar_tolerance\": 0.50,\n  \"percent_tolerance\": 0.01\n}"
      },
      "name": "Compare Totals (Pure Python)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "YOUR_ANTHROPIC_API_KEY"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-5-5\",\n  \"max_tokens\": 4096,\n  \"output_config\": { \"effort\": \"low\" },\n  \"system\": \"You are a financial discrepancy analyst. Classify reconciliation mismatches into clear root causes.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze the mathematical reconciliation result below and categorize the root discrepancy.\\nReconciliation Result:\\n{{ JSON.stringify($json) }}\"\n    }\n  ]\n}"
      },
      "name": "Classify Discrepancy (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "channel": "finance-discrepancies",
        "text": "=:warning: *Invoice Reconciliation Alert*\n*Vendor:* {{ $node[\"Parse Invoice JSON\"].json.vendor_name }}\n*Invoice #:* {{ $node[\"Parse Invoice JSON\"].json.invoice_number }}\n*PO #:* {{ $node[\"Parse Invoice JSON\"].json.po_number || 'NOT SPECIFIED' }}\n*Status:* {{ $node[\"Compare Totals (Pure Python)\"].json.status }}\n*Summary:* {{ $json.content.find(b => b.type === 'text')?.text }}"
      },
      "name": "Alert Bookkeeper (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1650, 300]
    }
  ],
  "connections": {
    "Google Drive Trigger": {
      "main": [
        [
          {
            "node": "Parse PDF (Cloud Run)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse PDF (Cloud Run)": {
      "main": [
        [
          {
            "node": "Extract Invoice Fields (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Invoice Fields (Claude)": {
      "main": [
        [
          {
            "node": "Parse Invoice JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Invoice JSON": {
      "main": [
        [
          {
            "node": "Lookup PO (Google Sheets)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lookup PO (Google Sheets)": {
      "main": [
        [
          {
            "node": "Compare Totals (Pure Python)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compare Totals (Pure Python)": {
      "main": [
        [
          {
            "node": "Classify Discrepancy (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify Discrepancy (Claude)": {
      "main": [
        [
          {
            "node": "Alert Bookkeeper (Slack)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
